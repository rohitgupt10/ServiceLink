<div class="custom-container py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2">My Favorites</h1>
    <p class="text-gray-600">Services you've saved for later</p>
  </div>

  <% if (favorites && favorites.length > 0) { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% favorites.forEach(fav => { %>
        <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
          <img src="<%= fav.service.thumbnail %>" alt="<%= fav.service.title %>" class="w-full h-48 object-cover">
          
          <div class="p-4">
            <h3 class="font-bold text-lg mb-2"><%= fav.service.title %></h3>
            
            <div class="flex items-center justify-between mb-3">
              <span class="text-lg font-bold text-indigo-600">Rs.<%= fav.service.price %></span>
              <span class="text-sm text-yellow-500">
                ⭐ <%= fav.service.averageRating.toFixed(1) %>
              </span>
            </div>

            <p class="text-sm text-gray-600 mb-3"><%= fav.service.description.substring(0, 100) %>...</p>

            <div class="flex items-center mb-3">
              <img src="<%= fav.service.provider.avatar %>" alt="Provider" class="w-6 h-6 rounded-full mr-2 object-cover">
              <span class="text-sm"><%= fav.service.provider.name %></span>
            </div>

            <div class="flex gap-2">
              <a href="/services/<%= fav.service._id %>" class="flex-1 bg-indigo-600 text-white text-center py-2 rounded hover:bg-indigo-700">
                View Details
              </a>
              <button class="flex-1 bg-red-100 text-red-600 py-2 rounded hover:bg-red-200 remove-favorite" data-service-id="<%= fav.service._id %>">
                Remove
              </button>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="bg-white rounded-lg shadow-md p-12 text-center">
      <p class="text-gray-500 text-lg mb-4">You haven't added any favorites yet.</p>
      <a href="/services" class="bg-indigo-600 text-white px-6 py-2 rounded hover:bg-indigo-700">
        Browse Services
      </a>
    </div>
  <% } %>
</div>

<script>
document.querySelectorAll('.remove-favorite').forEach(btn => {
  btn.addEventListener('click', async (e) => {
    if (confirm('Remove from favorites?')) {
      const serviceId = e.target.dataset.serviceId;
      const res = await fetch('/api/favorites/remove', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ serviceId })
      });
      if (res.ok) {
        e.target.closest('.bg-white').remove();
      }
    }
  });
});
</script>

