<div class="catalog-shell reference-catalog">
  <div class="catalog-title">
    <h1><%= user && user.role === 'provider' ? 'MANAGE SERVICES' : 'OUR SERVICES' %></h1>
    <span class="h-line"></span>
    <p><%= user && user.role === 'provider' ? 'Create and maintain the services you offer.' : 'Browse reliable professionals and book the right help for your needs.' %></p>
  </div>

  <div class="catalog-toolbar">
    <div class="breadcrumb"><a href="/">Home</a><span>›</span><strong>Services</strong></div>
    <span><%= services.length %> result<%= services.length === 1 ? '' : 's' %><%= query ? ` for “${query}”` : '' %></span>
    <% if (user && user.role === 'provider') { %><a href="/services/add" class="custom-bg catalog-add">Add service</a><% } %>
  </div>

  <div class="catalog-layout">
    <aside class="filter-card reference-filter">
      <h2>FILTER SERVICES</h2>
      <form method="GET">
        <label>Search<input name="q" value="<%= query || '' %>" placeholder="What do you need?"></label>
        <label>Category<select name="category"><option value="">All categories</option><% categories.forEach(category => { %><option value="<%= category %>" <%= selectedCategory === category ? 'selected' : '' %>><%= category %></option><% }) %></select></label>
        <button class="custom-bg">Apply filters</button>
        <a href="/services" class="clear-filter">Clear all filters</a>
      </form>
      <div class="filter-note"><strong>Book confidently</strong><p>Verified badges and ratings come from real ServiceLink activity.</p></div>
    </aside>

    <section class="catalog-results">
      <% if (error) { %><div class="notice-error"><%= error %></div><% } %>
      <% if (!services.length) { %><div class="empty-state"><span>⌕</span><h2>No services found</h2><p>Try a broader search or clear the category filter.</p><a href="/services" class="admin-primary">Clear filters</a></div><% } else { %>
        <div class="catalog-list">
          <% services.forEach(service => { %>
            <article class="service-list-card">
              <a href="/services/<%= service._id %>" class="service-list-image"><img src="<%= service.thumbnail %>" alt="<%= service.title %>"><% if (!service.isActive) { %><b>Paused</b><% } %></a>
              <div class="service-list-copy">
                <h2><a href="/services/<%= service._id %>"><%= service.title %></a></h2>
                <p><%= service.description %></p>
                <div class="listing-group"><h3>Category</h3><span><%= service.category %></span></div>
                <div class="listing-group"><h3>Provider</h3><span><%= service.provider.isVerified ? '✓ Verified · ' : '' %><%= service.provider.name %></span></div>
                <div class="listing-group"><h3>Location</h3><span><%= service.location %></span></div>
              </div>
              <div class="service-list-book">
                <strong>Rs.<%= service.price.toFixed(0) %> <small>per hour</small></strong>
                <div class="service-rating">★ <%= service.averageRating.toFixed(1) %> <small>(<%= service.totalReviews %>)</small></div>
                <% if (user && user.role === 'user') { %><button type="button" class="favorite-btn" data-service-id="<%= service._id %>" data-favorited="<%= favoriteIds.includes(service._id.toString()) %>"><%= favoriteIds.includes(service._id.toString()) ? '♥ Saved' : '♡ Save' %></button><% } %>
                <a class="custom-bg" href="/services/<%= service._id %>"><%= user && user.role === 'provider' ? 'Manage' : 'Book now' %></a>
                <a class="outline-action" href="/services/<%= service._id %>">More details</a>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>
</div>
