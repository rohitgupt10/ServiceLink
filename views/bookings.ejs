<div class="bookings-shell"><div class="catalog-heading"><div><p class="eyebrow">Your activity</p><h1><%= user.role === 'provider' ? 'Customer bookings' : 'My bookings' %></h1><p>Follow each service from request to payment receipt.</p></div><a href="/services" class="secondary-button">Browse services</a></div><% if (error) { %><div class="notice-error"><%= error %></div><% } %><div class="booking-list"><% if (!bookings.length) { %><div class="empty-state"><span>▣</span><h2>No bookings yet</h2><p>Your new requests will appear here.</p><a href="/services" class="admin-primary">Explore services</a></div><% } %><% bookings.forEach(booking => { %><article class="booking-item"><img src="<%= booking.service.thumbnail %>" alt="<%= booking.service.title %>"><div class="booking-main"><div class="booking-title-row"><div><p><%= booking.service.category %></p><h2><a href="/services/<%= booking.service._id %>"><%= booking.service.title %></a></h2></div><span class="status-pill status-<%= booking.status %>"><%= booking.status %></span></div><div class="booking-details"><span><small>Scheduled</small><strong><%= new Date(booking.date).toLocaleDateString() %></strong></span><span><small>Duration</small><strong><%= booking.hours %> hour<%= booking.hours === 1 ? '' : 's' %></strong></span><span><small><%= user.role === 'provider' ? 'Customer' : 'Provider' %></small><strong><%= user.role === 'provider' ? booking.user.name : booking.service.provider.name %></strong></span><span><small>Total</small><strong>Rs.<%= booking.totalPrice.toFixed(2) %></strong></span></div><div class="booking-actions"><span class="payment-state status-<%= booking.paymentStatus %>">Payment: <%= booking.paymentStatus %></span><% if (user.role === 'user' && booking.status === 'pending') { %><form action="/bookings/<%= booking._id %>/cancel" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger-button" data-confirm="Cancel this request?">Cancel request</button></form><% } %><% if (user.role === 'provider' && booking.status === 'pending') { %><form action="/bookings/<%= booking._id %>/confirm" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="admin-primary">Confirm booking</button></form><% } %><% if (user.role === 'user' && booking.status === 'confirmed' && booking.paymentStatus === 'unpaid') { %><a href="/payments/checkout/<%= booking._id %>" class="admin-primary">Pay securely (demo)</a><% } %><% if (booking.payment) { %><a href="/payments/<%= booking.payment %>/receipt" class="secondary-button">Receipt</a><% } %><% if (booking.status === 'confirmed' && booking.paymentStatus === 'paid' && ((user.role === 'user' && !booking.userCompleted) || (user.role === 'provider' && !booking.providerCompleted))) { %><form action="/bookings/<%= booking._id %>/complete" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="secondary-button" data-confirm="Confirm that this service is complete?">Mark complete</button></form><% } %></div></div></article><% }) %></div></div>
