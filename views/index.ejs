<% const fallbackSlides = [
  { _id: null, thumbnail: '/images/service-placeholder.svg', category: 'Home care', title: 'Trusted help for a home that feels its best', description: 'Discover dependable local professionals for cleaning, repairs, and everyday tasks.' },
  { _id: null, thumbnail: '/images/service-placeholder.svg', category: 'Skilled professionals', title: 'The right expert for every job', description: 'Compare clear prices, real profiles, and reviews from completed ServiceLink bookings.' },
  { _id: null, thumbnail: '/images/service-placeholder.svg', category: 'Local community', title: 'Book confidently from start to finish', description: 'Send a request, pay through the demo checkout, and keep every step in one place.' }
]; const heroSlides = featuredServices.length ? featuredServices.slice(0, 3) : fallbackSlides; %>

<section class="home-carousel" aria-label="Featured services">
  <div class="carousel-track">
    <% heroSlides.forEach((slide, index) => { %>
      <article class="carousel-slide <%= index === 0 ? 'active' : '' %>" data-carousel-slide aria-hidden="<%= index === 0 ? 'false' : 'true' %>">
        <img src="<%= slide.thumbnail %>" alt="<%= slide.title %>">
        <div class="carousel-shade"></div>
        <div class="carousel-caption">
          <p><%= slide.category %></p>
          <h1><%= slide.title %></h1>
          <span><%= slide.description %></span>
          <a href="<%= slide._id ? `/services/${slide._id}` : '/services' %>">Explore services</a>
        </div>
      </article>
    <% }) %>
  </div>
  <% if (heroSlides.length > 1) { %>
    <button class="carousel-control previous" type="button" data-carousel-previous aria-label="Previous slide">‹</button>
    <button class="carousel-control next" type="button" data-carousel-next aria-label="Next slide">›</button>
    <div class="carousel-dots" aria-label="Choose a slide">
      <% heroSlides.forEach((slide, index) => { %><button class="<%= index === 0 ? 'active' : '' %>" type="button" data-carousel-dot="<%= index %>" aria-label="Show slide <%= index + 1 %>"></button><% }) %>
    </div>
  <% } %>
</section>

<section class="availability-panel">
  <div class="availability-card">
    <h2>Find a service</h2>
    <form action="/services" method="GET">
      <label><span>What do you need?</span><input name="q" placeholder="Cleaning, tutoring, tech support..."></label>
      <label><span>Category</span><select name="category"><option value="">All categories</option><% (navCategories || []).forEach(category => { %><option value="<%= category %>"><%= category %></option><% }) %></select></label>
      <button class="custom-bg" type="submit">Search</button>
    </form>
  </div>
</section>

<section id="categories" class="home-section reference-section">
  <div class="reference-heading"><h2>POPULAR CATEGORIES</h2><span class="h-line"></span><p>Explore trusted professionals for the work you need most.</p></div>
  <div class="category-showcase">
    <% const categoryIcons = { Cleaning:'🧹', Delivery:'🚚', 'Event Staffing':'🎪', 'Furniture Assembly':'🪑', Gardening:'🌿', Handyman:'🛠️', Mounting:'🖼️', Moving:'📦', 'Personal Assistant':'📋', 'Pet Care':'🐾', 'Tech Support':'💻', Tutoring:'📚' }; (navCategories || []).slice(0,5).forEach((category) => { %>
      <a href="/services?category=<%= encodeURIComponent(category) %>"><span><%= categoryIcons[category] || '✦' %></span><strong><%= category %></strong></a>
    <% }) %>
  </div>
  <div class="section-more"><a href="/services">More categories &gt;&gt;&gt;</a></div>
</section>

<section class="reference-section featured-reference">
  <div class="home-section">
    <div class="reference-heading"><h2>FEATURED SERVICES</h2><span class="h-line"></span><p>Highly rated services from people in your community.</p></div>
    <div class="featured-grid">
      <% if (!featuredServices.length) { %><div class="empty-featured"><h3>Your marketplace is ready.</h3><p>Add service listings to populate this section.</p></div><% } %>
      <% featuredServices.forEach(service => { %>
        <article class="service-card">
          <a href="/services/<%= service._id %>" class="service-image"><img src="<%= service.thumbnail %>" alt="<%= service.title %>"></a>
          <div class="service-card-body">
            <h3><a href="/services/<%= service._id %>"><%= service.title %></a></h3>
            <p class="service-price">Rs.<%= service.price.toFixed(0) %> per hour</p>
            <div class="service-card-info"><div><h4>Category</h4><span><%= service.category %></span></div><div><h4>Location</h4><span><%= service.location %></span></div></div>
            <div class="service-rating"><span>★ <%= service.averageRating.toFixed(1) %></span> <small><%= service.totalReviews %> reviews</small></div>
            <div class="service-card-actions"><a class="custom-bg" href="/services/<%= service._id %>">Book now</a><a href="/services/<%= service._id %>">More details</a></div>
          </div>
        </article>
      <% }) %>
    </div>
    <div class="section-more"><a href="/services">More services &gt;&gt;&gt;</a></div>
  </div>
</section>

<section id="how-it-works" class="home-section reference-section">
  <div class="reference-heading"><h2>HOW IT WORKS</h2><span class="h-line"></span><p>One straightforward process from discovery to review.</p></div>
  <div class="steps-grid"><article><span>01</span><h3>Discover</h3><p>Filter local services by category, price, and trusted feedback.</p></article><article><span>02</span><h3>Book &amp; pay</h3><p>Choose a time, get confirmation, and complete the secure demo checkout.</p></article><article><span>03</span><h3>Review</h3><p>Share a verified review after the provider completes your booking.</p></article></div>
</section>

<section class="join-banner"><div><p class="eyebrow">Turn your skill into opportunity</p><h2>Ready to offer a service?</h2><p>Create a provider profile, add an image URL, and start receiving bookings.</p></div><a href="/auth/register">Become a provider</a></section>
