<div class="max-w-5xl mx-auto">
  <% if (error) { %><p class="bg-red-100 text-red-800 p-3 rounded mb-4"><%= error %></p><% } %>
  <% if (updated) { %><p class="bg-green-100 text-green-800 p-3 rounded mb-4">Profile updated.</p><% } %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-7">
    <aside>
      <div class="bg-white border rounded-xl p-6 text-center"><img src="<%= profile.avatar %>" alt="<%= profile.name %>" class="w-32 h-32 rounded-full mx-auto object-cover"><h1 class="text-2xl font-bold mt-3"><%= profile.name %></h1><p class="text-gray-500"><%= profile.role === 'provider' ? 'Service Provider' : 'Customer' %></p><% if (profile.isVerified) { %><span class="inline-block mt-2 bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm">✓ Verified</span><% } %><% if (profile.bio) { %><p class="mt-4 border-t pt-4 text-left"><%= profile.bio %></p><% } %><% if (canViewPrivate) { %><div class="mt-4 border-t pt-4 text-left text-sm"><p><%= profile.email %></p><p><%= profile.contact %></p></div><% } %></div>
      <div class="bg-white border rounded-xl p-5 mt-5 space-y-2"><h2 class="font-bold">Statistics</h2><p class="flex justify-between"><span>Rating</span><strong><%= profile.averageRating.toFixed(1) %>/5</strong></p><p class="flex justify-between"><span>Reviews</span><strong><%= profile.totalReviews %></strong></p><% if (profile.role === 'provider') { %><p class="flex justify-between"><span>Completed</span><strong><%= completedBookings %></strong></p><p class="flex justify-between"><span>Earnings</span><strong>Rs.<%= profile.totalEarnings.toFixed(2) %></strong></p><% } %></div>
    </aside>
    <main class="md:col-span-2 space-y-6">
      <% if (isSelfProfile) { %><section class="bg-white border rounded-xl p-5"><h2 class="text-xl font-bold mb-4">Edit profile</h2><form action="/profile/update" method="POST" enctype="multipart/form-data" class="grid grid-cols-1 md:grid-cols-2 gap-4 profile-edit-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Name<input name="name" value="<%= profile.name %>" class="w-full border rounded p-2" required maxlength="100"></label><label>Contact<input name="contact" value="<%= profile.contact %>" class="w-full border rounded p-2" required maxlength="30"></label><label class="md:col-span-2">Change profile image<input type="file" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif" class="w-full border rounded p-2"><span class="text-xs text-gray-500">Leave empty to keep the current image. Maximum 5 MB.</span></label><label class="md:col-span-2">Bio<textarea name="bio" class="w-full border rounded p-2" maxlength="500" rows="3"><%= profile.bio %></textarea></label><button class="bg-indigo-600 text-white rounded px-4 py-2">Save profile</button></form></section><% } %>
      <section class="bg-white border rounded-xl p-5"><h2 class="text-xl font-bold mb-4"><%= profile.role === 'provider' ? 'Customer reviews' : 'Given reviews' %></h2><div class="space-y-4"><% if (!reviews.length) { %><p class="text-gray-500">No reviews yet.</p><% } %><% reviews.forEach(review => { %><article class="border-b pb-4"><div class="flex justify-between"><strong><%= review.user ? review.user.name : profile.name %></strong><span class="text-yellow-500"><%= review.rating %>/5 ★</span></div><% if (review.service) { %><p class="text-sm text-gray-500"><%= review.service.title %></p><% } %><p><%= review.comment %></p><% if (review.images?.length) { %><div class="flex gap-2 mt-2"><% review.images.forEach(url => { %><img src="<%= url %>" alt="Review image" class="w-20 h-20 object-cover rounded"><% }) %></div><% } %></article><% }) %></div></section>
    </main>
  </div>
</div>
