<div class="max-w-5xl mx-auto">
  <h1 class="text-3xl font-bold mb-2">Disputes</h1><p class="text-gray-600 mb-6"><%= user.role === 'provider' ? 'Review disputes involving your services.' : 'Track issues related to completed or cancelled bookings.' %></p>
  <p id="feedback" class="hidden p-3 rounded mb-4"></p>
  <% if (user.role === 'user') { %><section class="bg-white border rounded-xl p-5 mb-7"><h2 class="text-xl font-bold mb-4">File a dispute</h2><form id="newDisputeForm" class="space-y-3"><label class="block">Eligible booking<select name="bookingId" class="w-full border rounded p-2" required><option value="">Select a booking</option></select></label><label class="block">Title<input name="title" class="w-full border rounded p-2" minlength="3" maxlength="120" required></label><label class="block">Description<textarea name="description" class="w-full border rounded p-2" minlength="10" maxlength="2000" rows="4" required></textarea></label><button class="bg-indigo-600 text-white px-5 py-2 rounded">File dispute</button></form></section><% } %>
  <section><h2 class="text-xl font-bold mb-4"><%= user.role === 'provider' ? 'Service disputes' : 'My disputes' %></h2><div id="disputesList" class="space-y-4"><p class="text-gray-500">Loading…</p></div></section>
</div>
<script>
  const esc = value => String(value ?? '').replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
  const role = <%- JSON.stringify(user.role) %>;
  function feedback(message, error = false) { const box = document.getElementById('feedback'); box.textContent = message; box.className = `p-3 rounded mb-4 ${error ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800'}`; }
  async function loadDisputes() {
    const response = await fetch(role === 'provider' ? '/api/disputes/provider-disputes' : '/api/disputes/my-disputes');
    const data = await response.json();
    const container = document.getElementById('disputesList');
    if (!response.ok) { container.textContent = data.message || 'Could not load disputes.'; return; }
    if (!data.disputes.length) { container.innerHTML = '<p class="text-gray-500">No disputes found.</p>'; return; }
    container.innerHTML = data.disputes.map(dispute => {
      const service = dispute.booking?.service?.title || 'Unavailable service';
      const actions = role === 'provider' && ['open','under_review'].includes(dispute.status) ? `<form class="resolve-form grid md:grid-cols-3 gap-2 mt-3" data-id="${esc(dispute._id)}"><select name="resolution" class="border rounded p-2" required><option value="">Resolution</option><option value="refund">Refund</option><option value="rework">Rework</option><option value="partial_refund">Partial refund</option><option value="no_action">No action</option></select><input name="resolutionDetails" class="border rounded p-2" placeholder="Resolution details" required><button class="bg-indigo-600 text-white rounded">Resolve</button></form>` : role === 'user' && dispute.status === 'resolved' ? `<button class="close-dispute text-indigo-600 mt-3" data-id="${esc(dispute._id)}">Close dispute</button>` : '';
      return `<article class="bg-white border rounded-xl p-5"><div class="flex justify-between gap-3"><div><h3 class="font-bold">${esc(dispute.title)}</h3><p class="text-sm text-gray-500">${esc(service)}</p></div><span class="text-sm font-semibold">${esc(dispute.status.replace('_',' '))}</span></div><p class="my-3">${esc(dispute.description)}</p>${dispute.resolutionDetails ? `<p class="bg-gray-50 p-2 text-sm"><strong>Resolution:</strong> ${esc(dispute.resolutionDetails)}</p>` : ''}${actions}</article>`;
    }).join('');
    document.querySelectorAll('.resolve-form').forEach(form => form.addEventListener('submit', resolveDispute));
    document.querySelectorAll('.close-dispute').forEach(button => button.addEventListener('click', closeDispute));
  }
  async function resolveDispute(event) { event.preventDefault(); const form = event.currentTarget; const values = Object.fromEntries(new FormData(form)); const response = await fetch(`/api/disputes/${form.dataset.id}/resolve`, { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify(values) }); const data = await response.json(); feedback(data.message, !response.ok); if (response.ok) loadDisputes(); }
  async function closeDispute(event) { const response = await fetch(`/api/disputes/${event.currentTarget.dataset.id}/close`, { method: 'PUT' }); const data = await response.json(); feedback(data.message, !response.ok); if (response.ok) loadDisputes(); }
  async function loadBookings() { if (role !== 'user') return; const response = await fetch('/profile/bookings/history'); const data = await response.json(); const select = document.querySelector('[name="bookingId"]'); (data.bookings || []).forEach(booking => { const option = document.createElement('option'); option.value = booking._id; option.textContent = `${booking.service.title} — ${new Date(booking.date).toLocaleDateString()}`; select.append(option); }); }
  document.getElementById('newDisputeForm')?.addEventListener('submit', async event => { event.preventDefault(); const values = Object.fromEntries(new FormData(event.currentTarget)); const response = await fetch('/api/disputes/create', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(values) }); const data = await response.json(); feedback(data.message, !response.ok); if (response.ok) { event.currentTarget.reset(); loadDisputes(); } });
  loadDisputes(); loadBookings();
</script>
