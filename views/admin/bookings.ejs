<div class="admin-page-heading"><div><p class="eyebrow">Operations</p><h1>Bookings</h1><p>Track every request from booking through completion.</p></div><form class="admin-filter" method="GET"><select name="status" onchange="this.form.submit()"><option value="">All statuses</option><% ['pending','confirmed','complete','cancelled'].forEach(value => { %><option value="<%= value %>" <%= status === value ? 'selected' : '' %>><%= value %></option><% }) %></select></form></div>
<section class="admin-panel"><div class="table-scroll"><table class="admin-table"><thead><tr><th>Service</th><th>Customer</th><th>Provider</th><th>Scheduled</th><th>Total</th><th>Payment</th><th>Status</th></tr></thead><tbody><% bookings.forEach(item => { %><tr><td><strong><%= item.service.title %></strong></td><td><%= item.user ? item.user.name : 'Unknown' %></td><td><%= item.service.provider ? item.service.provider.name : 'Unknown' %></td><td><%= new Date(item.date).toLocaleDateString() %> · <%= item.hours %>h</td><td>Rs.<%= item.totalPrice.toFixed(2) %></td><td><span class="status-pill status-<%= item.paymentStatus %>"><%= item.paymentStatus %></span></td><td><span class="status-pill status-<%= item.status %>"><%= item.status %></span></td></tr><% }) %></tbody></table></div></section>
