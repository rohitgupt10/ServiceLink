<div class="admin-page-heading"><div><p class="eyebrow">Demo gateway</p><h1>Payments</h1><p>Inspect simulated transactions and issue simulated refunds.</p></div><span class="demo-badge">Demo only</span></div>
<section class="admin-panel"><div class="table-scroll"><table class="admin-table"><thead><tr><th>Transaction</th><th>Booking</th><th>Customer</th><th>Provider</th><th>Amount</th><th>Status</th><th></th></tr></thead><tbody><% payments.forEach(item => { %><tr><td><strong><%= item.transactionId || 'Not captured' %></strong><br><small>•••• <%= item.last4 || '—' %></small></td><td><%= item.booking && item.booking.service ? item.booking.service.title : 'Unavailable' %></td><td><%= item.customer ? item.customer.name : 'Unknown' %></td><td><%= item.provider ? item.provider.name : 'Unknown' %></td><td>Rs.<%= item.amount.toFixed(2) %></td><td><span class="status-pill status-<%= item.status %>"><%= item.status %></span></td><td><div class="table-actions"><% if (item.status === 'paid') { %><a href="/payments/<%= item._id %>/receipt">Receipt</a><form method="POST" action="/admin/payments/<%= item._id %>/refund"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger" data-confirm="Issue a demo refund?">Refund</button></form><% } %></div></td></tr><% }) %></tbody></table></div></section>
