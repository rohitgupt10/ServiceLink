<div class="admin-page-heading"><div><p class="eyebrow">Trust & safety</p><h1>Provider verification</h1><p>Review provider accounts and control the public trust badge.</p></div></div>
<section class="admin-panel"><div class="table-scroll"><table class="admin-table"><thead><tr><th>Provider</th><th>Contact</th><th>Rating</th><th>Account</th><th>Verification</th><th></th></tr></thead><tbody><% providers.forEach(item => { %><tr><td><div class="person-cell"><img src="<%= item.avatar %>" alt=""><span><strong><%= item.name %></strong><small>Joined <%= new Date(item.createdAt).toLocaleDateString() %></small></span></div></td><td><%= item.email %><br><small><%= item.contact %></small></td><td><%= item.averageRating.toFixed(1) %> / 5</td><td><span class="status-pill <%= item.isActive ? 'status-active' : 'status-cancelled' %>"><%= item.isActive ? 'Active' : 'Disabled' %></span></td><td><span class="status-pill <%= item.isVerified ? 'status-active' : 'status-pending' %>"><%= item.isVerified ? 'Verified' : 'Pending' %></span></td><td><form method="POST" action="/admin/verifications/<%= item._id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="table-action"><%= item.isVerified ? 'Remove badge' : 'Verify provider' %></button></form></td></tr><% }) %></tbody></table></div></section>
