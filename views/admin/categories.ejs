<div class="admin-page-heading"><div><p class="eyebrow">Catalogue</p><h1>Categories</h1><p>Keep the service catalogue easy to browse.</p></div><button class="admin-primary" data-dialog-open="categoryDialog">Add category</button></div>
<section class="admin-panel"><div class="category-grid"><% categories.forEach(item => { %><article class="category-admin-card"><div><span class="category-symbol"><%= item.name.charAt(0).toUpperCase() %></span><span><strong><%= item.name %></strong><small><%= item.isActive ? 'Visible to customers' : 'Hidden from filters' %></small></span></div><div class="table-actions"><form method="POST" action="/admin/categories/<%= item._id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button><%= item.isActive ? 'Hide' : 'Show' %></button></form><form method="POST" action="/admin/categories/<%= item._id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger" data-confirm="Delete this unused category?">Delete</button></form></div></article><% }) %></div></section>
<dialog id="categoryDialog" class="admin-dialog"><form method="POST" action="/admin/categories"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="dialog-heading"><h2>Add category</h2><button type="button" data-dialog-close>×</button></div><label>Category name<input name="name" minlength="2" maxlength="80" required autofocus></label><button class="admin-primary">Save category</button></form></dialog>
