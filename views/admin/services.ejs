<div class="admin-page-heading"><div><p class="eyebrow">Catalogue</p><h1>Services</h1><p>Moderate listings while preserving removed records.</p></div></div>
<section class="admin-panel"><div class="panel-heading"><div><h2>All listings</h2><p><%= services.length %> most recent services</p></div></div><div class="table-scroll"><table class="admin-table"><thead><tr><th>Service</th><th>Provider</th><th>Category</th><th>Price</th><th>Status</th><th>Actions</th></tr></thead><tbody><% services.forEach(service => { %><tr><td><div class="service-cell"><img src="<%= service.thumbnail %>" alt=""><strong><%= service.title %></strong></div></td><td><%= service.provider ? service.provider.name : 'Deleted user' %></td><td><%= service.category %></td><td>Rs.<%= service.price.toFixed(2) %></td><td><span class="status-pill <%= service.deletedAt ? 'status-cancelled' : service.isActive ? 'status-active' : 'status-pending' %>"><%= service.deletedAt ? 'Removed' : service.isActive ? 'Active' : 'Paused' %></span></td><td><div class="table-actions"><% if (!service.deletedAt) { %><form method="POST" action="/admin/services/<%= service._id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button><%= service.isActive ? 'Pause' : 'Activate' %></button></form><form method="POST" action="/admin/services/<%= service._id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger" data-confirm="Remove this service?">Remove</button></form><% } else { %><form method="POST" action="/admin/services/<%= service._id %>/restore"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>Restore</button></form><% } %></div></td></tr><% }) %></tbody></table></div></section>
