<div class="admin-page-heading"><div><p class="eyebrow">Accounts</p><h1>Users</h1><p>Search accounts and control marketplace access.</p></div></div>
<section class="admin-panel"><div class="panel-heading"><form class="admin-search" method="GET"><input name="q" value="<%= q %>" placeholder="Search name or email"><button>Search</button></form><span class="table-count"><%= users.length %> records</span></div><div class="table-scroll"><table class="admin-table"><thead><tr><th>User</th><th>Role</th><th>Joined</th><th>Status</th><th></th></tr></thead><tbody><% users.forEach(item => { %><tr><td><div class="person-cell"><img src="<%= item.avatar %>" alt=""><span><strong><%= item.name %></strong><small><%= item.email %></small></span></div></td><td><%= item.role %></td><td><%= new Date(item.createdAt).toLocaleDateString() %></td><td><span class="status-pill <%= item.isActive ? 'status-active' : 'status-cancelled' %>"><%= item.isActive ? 'Active' : 'Disabled' %></span></td><td><% if (item.role !== 'admin') { %><form method="POST" action="/admin/users/<%= item._id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="table-action"><%= item.isActive ? 'Disable' : 'Enable' %></button></form><% } %></td></tr><% }) %></tbody></table></div></section>
