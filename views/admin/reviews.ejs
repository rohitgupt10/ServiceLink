<div class="admin-page-heading"><div><p class="eyebrow">Trust & quality</p><h1>Reviews</h1><p>Moderate verified feedback and protect marketplace quality.</p></div></div>
<section class="admin-panel"><div class="review-admin-list"><% if (!reviews.length) { %><p class="empty-row">No reviews yet.</p><% } %><% reviews.forEach(item => { %><article><div><div class="review-stars"><%= '★'.repeat(item.rating) %><%= '☆'.repeat(5-item.rating) %></div><h3><%= item.service ? item.service.title : 'Deleted service' %></h3><p><%= item.comment %></p><small><%= item.user ? item.user.name : 'Deleted user' %> · <%= item.verified ? 'Verified booking' : 'Unverified' %> · <%= new Date(item.createdAt).toLocaleDateString() %></small></div><form method="POST" action="/admin/reviews/<%= item._id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger-button" data-confirm="Delete this review?">Delete</button></form></article><% }) %></div></section>
