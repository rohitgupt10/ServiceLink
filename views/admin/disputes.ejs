<div class="admin-page-heading"><div><p class="eyebrow">Resolution centre</p><h1>Disputes</h1><p>Review evidence and record clear outcomes.</p></div></div>
<div class="dispute-admin-list"><% if (!disputes.length) { %><section class="admin-panel"><p class="empty-row">No disputes have been opened.</p></section><% } %><% disputes.forEach(item => { %><article class="admin-panel dispute-card"><div class="panel-heading"><div><h2><%= item.title %></h2><p><%= item.initiatedBy ? item.initiatedBy.name : 'Unknown user' %> · <%= item.booking && item.booking.service ? item.booking.service.title : 'Unavailable booking' %></p></div><span class="status-pill status-<%= item.status %>"><%= item.status.replace('_',' ') %></span></div><p class="dispute-copy"><%= item.description %></p><% if (item.status === 'open') { %><form method="POST" action="/admin/disputes/<%= item._id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="secondary-button">Mark under review</button></form><% } %><% if (['open','under_review'].includes(item.status)) { %><form method="POST" action="/admin/disputes/<%= item._id %>/resolve" class="resolution-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="resolution" required><option value="">Choose resolution</option><option value="refund">Refund</option><option value="partial_refund">Partial refund</option><option value="rework">Rework</option><option value="no_action">No action</option></select><input name="resolutionDetails" minlength="3" maxlength="1000" placeholder="Explain the decision" required><button class="admin-primary">Resolve</button></form><% } else { %><div class="resolution-result"><strong><%= item.resolution ? item.resolution.replace('_',' ') : 'Resolved' %></strong><p><%= item.resolutionDetails %></p></div><% } %></article><% }) %></div>
