<div class="checkout-shell">
  <section class="checkout-summary"><p class="eyebrow">Secure demo checkout</p><h1>Complete your booking</h1><img src="<%= booking.service.thumbnail %>" alt="<%= booking.service.title %>"><h2><%= booking.service.title %></h2><p>Provided by <%= booking.service.provider.name %></p><dl><div><dt>Service date</dt><dd><%= new Date(booking.date).toLocaleDateString() %></dd></div><div><dt>Duration</dt><dd><%= booking.hours %> hour<%= booking.hours === 1 ? '' : 's' %></dd></div><div class="checkout-total"><dt>Total</dt><dd>Rs.<%= booking.totalPrice.toFixed(2) %></dd></div></dl></section>
  <section class="payment-card"><div class="demo-banner"><strong>Demo payment</strong><span>No money will be charged.</span></div><h2>Card details</h2><p class="payment-help">Use <button type="button" class="copy-card" data-copy="<%= testCards.success %>"><%= testCards.success.replace(/(.{4})/g, '$1 ').trim() %></button> for success.</p><% if (error) { %><div class="notice-error"><%= error %></div><% } %><form method="POST" action="/payments/checkout/<%= booking._id %>" class="payment-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Cardholder name<input name="cardholder" autocomplete="cc-name" required placeholder="Demo Customer"></label><label>Card number<input name="cardNumber" id="cardNumber" inputmode="numeric" autocomplete="cc-number" maxlength="19" required placeholder="4242 4242 4242 4242"></label><div class="field-row"><label>Expiry<input name="expiry" value="12/30" inputmode="numeric" required></label><label>CVV<input name="cvv" value="123" inputmode="numeric" maxlength="4" required></label></div><button class="admin-primary payment-submit">Pay Rs.<%= booking.totalPrice.toFixed(2) %></button><small>This simulator validates only the provided test number and never stores cardholder, card number, expiry, or CVV.</small></form></section>
</div>
