<div class="receipt-shell"><section class="receipt-card"><div class="receipt-check">✓</div><p class="eyebrow"><%= payment.status === 'refunded' ? 'Demo refund recorded' : 'Demo payment complete' %></p><h1><%= payment.status === 'refunded' ? 'Payment refunded' : 'Thanks, payment received' %></h1><p class="receipt-lead">This receipt records a simulated transaction. No real funds were transferred.</p><div class="receipt-service"><img src="<%= payment.booking.service.thumbnail %>" alt=""><span><strong><%= payment.booking.service.title %></strong><small><%= new Date(payment.booking.date).toLocaleDateString() %> · <%= payment.booking.hours %>h</small></span></div><dl><div><dt>Transaction</dt><dd><%= payment.transactionId %></dd></div><div><dt>Customer</dt><dd><%= payment.customer.name %></dd></div><div><dt>Provider</dt><dd><%= payment.provider.name %></dd></div><div><dt>Payment method</dt><dd>Demo card •••• <%= payment.last4 %></dd></div><div class="checkout-total"><dt>Total</dt><dd>Rs.<%= payment.amount.toFixed(2) %> <%= payment.currency %></dd></div></dl><div class="receipt-actions"><a href="/bookings" class="admin-primary">Back to bookings</a><button type="button" class="secondary-button" onclick="window.print()">Print receipt</button></div></section></div>
