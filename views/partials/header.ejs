<header class="site-header sticky top-0 z-50">
  <nav class="site-nav" aria-label="Main navigation">
    <a href="/" class="brand-mark">ServiceLink</a>
    <div class="desktop-nav">
      <a href="/" class="nav-link">Home</a>
      <a href="/services" class="nav-link">Services</a>
      <a href="/#categories" class="nav-link">Categories</a>
      <a href="/#how-it-works" class="nav-link">How it works</a>
      <% if (user && user.role !== 'admin') { %><a href="/bookings" class="nav-link">Bookings</a><% } %>
      <% if (user && user.role === 'user') { %><a href="/favorites" class="nav-link">Saved</a><% } %>
    </div>
    <div class="nav-actions">
      <% if (!user) { %>
        <a href="/auth/login" class="nav-outline">Login</a>
        <a href="/auth/register" class="nav-outline">Register</a>
      <% } else { %>
        <% const notificationCount = typeof unreadNotificationCount === 'number' ? unreadNotificationCount : 0; %>
        <% const modeLabel = user.role === 'provider' ? 'Provider mode' : user.role === 'admin' ? 'Admin mode' : 'User mode'; %>
        <span class="session-mode mode-<%= user.role %>"><span></span><%= modeLabel %></span>
        <a href="/notifications" class="notification-link" aria-label="Notifications">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <% if (notificationCount) { %><span><%= notificationCount > 9 ? '9+' : notificationCount %></span><% } %>
        </a>
        <div class="nav-dropdown account-dropdown">
          <button class="account-button" type="button" aria-label="Open account menu"><img src="<%= user.avatar %>" alt=""><span><%= user.name.split(' ')[0] %></span><small>⌄</small></button>
          <div class="nav-menu account-menu"><a href="<%= user.role === 'admin' ? '/admin' : user.role === 'provider' ? '/profile/dashboard/provider' : '/dashboard' %>">Dashboard</a><% if (user.role !== 'admin') { %><a href="/profile/<%= user.id %>">Profile</a><a href="/disputes">Disputes</a><% } %><form action="/auth/logout" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>Sign out</button></form></div>
        </div>
      <% } %>
      <button id="mobile-menu-button" class="mobile-menu-button" type="button" aria-label="Open navigation" aria-expanded="false">☰</button>
    </div>
  </nav>
  <div id="mobile-menu" class="mobile-menu hidden"><% if (user) { %><p class="mobile-mode"><%= user.role === 'provider' ? 'Provider mode' : user.role === 'admin' ? 'Admin mode' : 'User mode' %></p><% } %><a href="/">Home</a><a href="/services">Services</a><a href="/#categories">Categories</a><a href="/#how-it-works">How it works</a><% if (user && user.role !== 'admin') { %><a href="/bookings">Bookings</a><% } %><% if (user && user.role === 'user') { %><a href="/favorites">Saved services</a><% } %><% if (user && user.role === 'admin') { %><a href="/admin">Admin dashboard</a><% } %></div>
</header>
