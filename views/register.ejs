<section class="auth-shell">
  <div class="auth-card auth-card-wide">
    <div class="auth-heading"><p>Create an account</p><h1>JOIN SERVICELINK</h1><span class="h-line"></span></div>
    <% if (error) { %><div class="notice-error"><%= error %></div><% } %>
    <form action="/auth/register" method="POST" enctype="multipart/form-data" id="registerForm" class="auth-form auth-form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Full name<input type="text" name="name" minlength="2" maxlength="100" required></label>
      <label>Email address<input type="email" name="email" required></label>
      <label>Phone number<input type="tel" name="contact" minlength="5" maxlength="30" required></label>
      <label>Account type<select name="role" required><option value="">Select an option</option><option value="user">Service seeker</option><option value="provider">Service provider</option></select></label>
      <label class="avatar-upload-field">Profile image <span class="avatar-upload-control"><img id="avatarPreview" src="/images/default-avatar.svg" alt="Profile image preview"><span><input type="file" id="avatar" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif"><small>Optional · JPG, PNG, WEBP or GIF · maximum 5 MB</small></span></span></label>
      <label>Password<input type="password" id="password" name="password" minlength="8" required></label>
      <label>Confirm password<input type="password" id="confirmPassword" name="confirmPassword" minlength="8" required><span id="passwordError" class="hidden form-error">Passwords do not match.</span></label>
      <button class="custom-bg auth-submit auth-grid-submit">Register</button>
    </form>
    <p class="auth-switch">Already have an account? <a href="/auth/login">Login here</a></p>
  </div>
</section>
<script>
  document.getElementById('registerForm').addEventListener('submit', (event) => {
    const matches = document.getElementById('password').value === document.getElementById('confirmPassword').value;
    document.getElementById('passwordError').classList.toggle('hidden', matches);
    if (!matches) event.preventDefault();
  });
  document.getElementById('avatar').addEventListener('change', (event) => {
    const file = event.target.files[0];
    if (file) document.getElementById('avatarPreview').src = URL.createObjectURL(file);
  });
</script>
