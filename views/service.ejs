<div class="detail-shell"><div class="breadcrumb"><a href="/">Home</a><span>›</span><a href="/services">Services</a><span>›</span><%= service.category %></div><div class="detail-layout"><section><div class="detail-image"><img src="<%= service.thumbnail %>" alt="<%= service.title %>"><span><%= service.category %></span></div><div class="detail-heading"><div><p class="eyebrow"><%= service.location %></p><h1><%= service.title %></h1><div class="detail-meta"><span class="review-stars">★ <%= service.averageRating.toFixed(1) %></span><span><%= service.totalReviews %> verified reviews</span><span>·</span><span><%= service.viewCount %> views</span></div></div><% if (user && user.role === 'user') { %><button id="favoriteButton" data-id="<%= service._id %>" data-favorited="<%= isFavorited %>" class="save-button"><%= isFavorited ? '♥ Saved' : '♡ Save' %></button><% } %></div><article class="detail-description"><h2>About this service</h2><p><%= service.description %></p><% if (service.tags.length) { %><div class="tag-list"><% service.tags.forEach(tag => { %><span><%= tag %></span><% }) %></div><% } %></article><section class="provider-box"><img src="<%= service.provider.avatar %>" alt=""><div><p class="eyebrow">Your provider</p><h2><a href="/profile/<%= service.provider._id %>"><%= service.provider.name %></a> <% if (service.provider.isVerified) { %><span class="verified-mark">✓ Verified</span><% } %></h2><p><%= service.provider.bio || 'A local ServiceLink provider ready to help.' %></p></div></section>
<section class="reviews-section"><div class="section-heading"><div><p class="eyebrow">Customer feedback</p><h2>Verified reviews</h2></div></div><div class="review-list"><% if (!reviews.length) { %><div class="empty-state"><h3>No reviews yet</h3><p>Completed customers can be the first to share their experience.</p></div><% } %><% reviews.forEach(review => { %><article><div class="review-head"><div class="person-cell"><img src="<%= review.user.avatar %>" alt=""><span><strong><%= review.user.name %></strong><small><%= new Date(review.createdAt).toLocaleDateString() %></small></span></div><span class="review-stars"><%= '★'.repeat(review.rating) %><%= '☆'.repeat(5-review.rating) %></span></div><p><%= review.comment %></p><% if (review.verified) { %><span class="verified-review">✓ Verified booking</span><% } %><% if (review.images.length) { %><div class="review-images"><% review.images.forEach(url => { %><img src="<%= url %>" alt="Review image"><% }) %></div><% } %></article><% }) %></div></section>
<% if (user && user.role === 'user') { %><section class="write-review"><h2>Share your experience</h2><p>Reviews are accepted only after a completed booking.</p><% if (reviewError) { %><div class="notice-error"><%= reviewError %></div><% } %><form action="/services/<%= service._id %>/reviews" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="rating-fields"><% [['rating','Overall'],['qualityRating','Quality'],['communicationRating','Communication'],['timelinessRating','Timeliness']].forEach(([name,label],index) => { %><label><%= label %><select name="<%= name %>" <%= index === 0 ? 'required' : '' %>><option value="">Select</option><% for(let i=5;i>=1;i--){ %><option value="<%= i %>"><%= i %> / 5</option><% } %></select></label><% }) %></div><label>Review<textarea name="comment" rows="4" minlength="3" maxlength="1000" required></textarea></label><label>Image URLs <span>(optional, comma or line separated)</span><textarea name="images" rows="2" placeholder="https://..."></textarea></label><button class="admin-primary">Submit review</button></form></section><% } %></section>
<aside><div class="booking-card"><p class="booking-price"><strong>Rs.<%= service.price.toFixed(0) %></strong> / hour</p><div class="booking-facts"><span><small>Provider</small><strong><%= service.provider.name %></strong></span><span><small>Contact</small><strong><%= service.contact %></strong></span></div><% if (user && user.role === 'user') { %><form action="/bookings/create" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="serviceId" value="<%= service._id %>"><label>Service date<input type="date" name="date" required></label><label>Hours<input type="number" name="hours" min="1" max="8" value="1" required></label><button class="admin-primary">Request booking</button></form><p class="booking-note">You will pay only after the provider confirms this request.</p><% } else if (!user) { %><a href="/auth/login" class="admin-primary booking-login">Log in to book</a><% } else if (user.role === 'provider' && user.id === service.provider._id.toString()) { %><a href="/services/<%= service._id %>/edit" class="admin-primary booking-login">Edit this service</a><% } %></div></aside></div></div>
