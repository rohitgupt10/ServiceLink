PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/servicelink
SESSION_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# Optional. Prefer `npm run dev:local` instead of editing this directly.
USE_LOCAL_DB=false

# Used only by npm run admin:create
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_NAME=ServiceLink Admin
ADMIN_CONTACT=Administrator
